# Salin file ini menjadi .env untuk dipakai di komputer sendiri (vercel dev).
# Untuk produksi, isi di Vercel: Project Settings, Environment Variables.
# Jangan commit file .env ke GitHub.

# Wajib bila ingin memakai kunci server
GEMINI_API_KEY=

# Opsional: daftar model yang diizinkan, urutan pertama dicoba lebih dulu
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview

# Opsional: batasi asal permintaan, pisahkan dengan koma
# ALLOWED_ORIGIN=https://bantuan.utfamily.my.id
